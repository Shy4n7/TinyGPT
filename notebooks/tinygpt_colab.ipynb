   "source": [
    "## 🎭 Shakespeare Text Generation Sample"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "prompt = \"HAMLET:\"\n",
    "prompt_tokens = [char_to_id.get(c, 0) for c in prompt]\n",
    "idx = torch.tensor([prompt_tokens], dtype=torch.long, device=device)\n",
    "model_v3.eval()\n",
    "generated = model_v3.generate(idx, max_new_tokens=300, temperature=0.8, top_k=10)\n",
    "sample_text = \"\".join([id_to_char[i.item()] for i in generated[0]])\n",
    "print(\"=== Generated Shakespeare Text ===\")\n",
    "print(sample_text)"
   ]
  }
